!{explode domain(vhn)}
# IMAPS proxy configuration
#
server
{
    server_name         ${vhn};
    # The listen address prefix is empty (all addresses) unless zimbraReverseProxySNIEnabled is
    # FALSE, in which case the deprecated zimbraVirtualIPAddress of the domain is used. IP-based
    # virtual hosting is deprecated; note that the nginx mail module cannot select a certificate
    # by SNI, so a per-domain certificate here only works with the legacy Virtual IP setup.
    ${core.ipboth.enabled}listen              ${vip}${mail.imaps.port} ssl;
    ${core.ipv4only.enabled}listen            ${vip}${mail.imaps.port} ssl;
    ${core.ipv6only.enabled}listen            ${vip}${mail.imaps.port} ssl;
    protocol            imap;
    proxy               on;
    timeout             ${mail.imap.timeout};
    proxy_timeout       ${mail.imap.proxytimeout};
    ssl_certificate     ${ssl.crt};
    ssl_certificate_key ${ssl.key};
    sasl_service_name   "imap";
}

